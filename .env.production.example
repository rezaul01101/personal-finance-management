APP_NAME="Personal Finance Management"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL runs in its own `mysql` service/container, reachable on the shared
# `laravel` compose network at the hostname `mysql` (not 127.0.0.1).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=personal_finance_management
DB_USERNAME=finance_app
DB_PASSWORD=CHANGE_ME
# Root password for the `mysql` service container (used by its own
# initialisation and healthcheck, not by the app itself).
MYSQL_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set to false after the first successful deploy if you'd rather run
# migrations manually.
RUN_MIGRATIONS=true

VITE_APP_NAME="${APP_NAME}"
